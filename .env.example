# ─── Cithai — environment variable template ───────────────────────────────────
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# .env is listed in .gitignore and must NEVER be committed to the repository.
# ──────────────────────────────────────────────────────────────────────────────

# Django secret key — generate a new one for every deployment:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-cithai-dev-key-change-in-production

# ── Music generation strategy ─────────────────────────────────────────────────
# Set to "mock" for local development (no API key required).
# Set to "suno" to use the real Suno API.
GENERATOR_STRATEGY=mock

# ── Google OAuth credentials ──────────────────────────────────────────────────
# 1. Go to https://console.cloud.google.com/
# 2. Create a project → APIs & Services → Credentials → Create OAuth 2.0 Client ID
# 3. Application type: Web application
# 4. Authorised redirect URI: http://127.0.0.1:8000/auth/google/callback/
# WARNING: never commit these values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback/

# ── Suno API credentials (required only when GENERATOR_STRATEGY=suno) ─────────
# Obtain your key from the Suno developer portal.
SUNO_API_KEY=

# Suno API base URL (default is correct for most users)
SUNO_API_BASE_URL=https://api.sunoapi.org/api/v1

# Public callback URL that Suno will POST results to (must be reachable by Suno)
SUNO_CALLBACK_URL=https://example.com/api/suno/callback

# Suno model version
SUNO_MODEL=V4_5ALL
